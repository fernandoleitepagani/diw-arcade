#!/usr/bin/env bash
# Deterministic checks. Exit 0 only when the branch is fit to review.
set -euo pipefail
cd "$(dirname "$0")/.."
[ -f package.json ] || { echo "no package.json yet: scaffold task not merged" >&2; exit 1; }
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
npm ci --prefer-offline --no-audit --no-fund
npm run lint
npm run typecheck
npm test -- --run
npm run validate:content
npm run build
# Real-browser gate: catches a blank production bundle that jsdom tests cannot.
npm run smoke
npm run smoke -- --selftest
[ ! -f scripts/budget.ts ] || npm run budget
